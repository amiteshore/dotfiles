#!/bin/zsh

# =============== Navigation =============== #

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias -- -='cd -'

alias dot='cd ~/dotfiles'
alias w='cd ~/work'


# =============== Development =============== #

alias pd='pnpm dev'
alias pst='pnpm start'


# =============== Git =============== #

alias gl='git log'
alias ga='git add'
alias gaa='git add --all'
alias gb='git branch'
alias gs='git status'
alias gp='git push'
alias gc='git commit'


# =============== Files =============== #

alias ls='eza --all'
alias l='eza --all --long'
alias ll='eza --all --long --git'
alias lt='eza --all --tree'
alias cat='bat'


# =============== System =============== #

alias h='history'
alias sz='source ~/.zshrc'
alias path='echo -e ${PATH//:/\\n}'
alias disk='df -h'


# =============== Development shortcuts =============== #

alias pj='vim package.json'


# =============== Temporary =============== #

alias rmx='rm -rf .expo android ios node_modules'